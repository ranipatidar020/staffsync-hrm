PORT=5000
# Local MongoDB:
MONGODB_URI=mongodb://127.0.0.1:27017/staffsync
# Atlas example (use this on Render):
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/staffsync?retryWrites=true&w=majority
# Only needed if frontend is hosted on a different domain than the API:
# CLIENT_ORIGIN=https://your-frontend.onrender.com
# Set to false to skip inserting demo data into an empty database:
# SEED_DEMO=false
